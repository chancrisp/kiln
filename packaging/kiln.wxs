<!--
  Kiln's MSI, for WiX Toolset 5, installed as a dotnet global tool.
  Built by packaging/package.ps1, which passes Version and StageDir.

  A per-machine install into Program Files\Kiln, with a Start menu
  shortcut and the folder added to PATH so `kiln` works in a terminal.
  It also offers Kiln in Explorer's Open with, for every account on the PC,
  and adds a Send to shortcut for the installing account. Nothing claims a
  file type: no extension's default value is touched.
  The UpgradeCode never changes: it is how newer versions find and
  replace older ones.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Kiln"
           Manufacturer="Kiln contributors"
           Version="$(Version)"
           UpgradeCode="b09becc6-3b59-4cbb-aa13-8b59ea7e77f6"
           Scope="perMachine"
           Compressed="yes">
    <SummaryInformation Description="Kiln, a local file converter" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of Kiln is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- The Id ends in .exe for ICE50; Windows reads the icon from the file's contents, not its extension. -->
    <Icon Id="KilnIcon.exe" SourceFile="$(StageDir)\kiln.ico" />
    <Property Id="ARPPRODUCTICON" Value="KilnIcon.exe" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Kiln" />
    </StandardDirectory>

    <ComponentGroup Id="KilnFiles" Directory="INSTALLFOLDER">
      <Component>
        <File Source="$(StageDir)\kiln-app.exe" KeyPath="yes">
          <Shortcut Name="Kiln"
                    Description="Convert files on this PC"
                    Directory="ProgramMenuFolder"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="KilnIcon.exe"
                    Advertise="yes" />
        </File>
      </Component>
      <Component>
        <File Source="$(StageDir)\kiln.exe" KeyPath="yes" />
        <Environment Id="KilnPath" Name="PATH" Value="[INSTALLFOLDER]"
                     Part="last" Action="set" System="yes" Permanent="no" />
      </Component>
      <Component>
        <File Source="$(StageDir)\LICENSE" KeyPath="yes" />
      </Component>
      <Component>
        <File Source="$(StageDir)\THIRD_PARTY_LICENSES" KeyPath="yes" />
      </Component>
      <Component>
        <File Source="$(StageDir)\OFL.txt" KeyPath="yes" />
      </Component>
      <Component>
        <File Source="$(StageDir)\README.md" KeyPath="yes" />
      </Component>

      <!--
        Open with. The file types that list Kiln.Convert under
        OpenWithProgids are in open-with-types.wxs (OpenWithTypes).
        MultiSelectModel stays unset, so Explorer starts one Kiln per file
        and the running window gathers them.
      -->
      <Component Id="OpenWith">
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\kiln-app.exe"
                       Name="FriendlyAppName" Type="string" Value="Kiln" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\kiln-app.exe\shell\open\command"
                       Type="string" Value='"[INSTALLFOLDER]kiln-app.exe" "%1"' />
        <RegistryValue Root="HKLM" Key="Software\Classes\Kiln.Convert"
                       Type="string" Value="Kiln" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Kiln.Convert\DefaultIcon"
                       Type="string" Value='"[INSTALLFOLDER]kiln-app.exe",0' />
        <RegistryValue Root="HKLM" Key="Software\Classes\Kiln.Convert\shell\open\command"
                       Type="string" Value='"[INSTALLFOLDER]kiln-app.exe" "%1"' />
      </Component>
    </ComponentGroup>

    <!--
      Send to, for the account that installs Kiln. A per-user item in a
      per-machine package needs an HKCU key path (ICE38, ICE43, ICE57).
      Being per user, it is removed only by an uninstall run from the
      installing account. One run from a different admin account can't
      reach that account's profile, so the shortcut stays behind there.
      A repair or major upgrade run from a different admin account
      likewise installs Send to into that account as well, leaving the
      first account's shortcut behind.
      That comes with any per-user item.
      The shortcut has no Icon: one that points to kiln-app.exe shows the
      exe's own icon.
    -->
    <StandardDirectory Id="SendToFolder">
      <Component Id="SendTo">
        <Shortcut Id="SendToShortcut"
                  Name="Kiln"
                  Description="Convert files on this PC"
                  Target="[INSTALLFOLDER]kiln-app.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\Kiln" Name="SendTo"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main">
      <ComponentGroupRef Id="KilnFiles" />
      <ComponentGroupRef Id="OpenWithTypes" />
    </Feature>

    <!--
      Send to has a feature of its own. The Start menu shortcut is
      advertised, and launching it checks the key paths of its feature and
      that feature's parents. In Main, another account's launch would find
      this HKCU key path missing, repair the feature and copy Send to into
      that account, where uninstall would leave it behind. As a separate
      top-level feature it is never checked by that shortcut. It keeps the
      default level, so it still installs.
    -->
    <Feature Id="SendTo">
      <ComponentRef Id="SendTo" />
    </Feature>
  </Package>
</Wix>
