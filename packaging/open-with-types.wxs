<!--
  Explorer's Open with list: the file types Kiln converts from.

  The test in crates/kiln-core/tests/packaging.rs keeps this file in step
  with crates/kiln-core/formats.toml. When a new input format is added
  there, add its two lines here, one in SupportedTypes and one in
  OpenWithProgids. Windows reads only the value names, so the data is empty.
  A few inputs are left out on purpose; they are listed in that test.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <ComponentGroup Id="OpenWithTypes" Directory="INSTALLFOLDER">
      <Component>
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\kiln-app.exe\SupportedTypes" Name=".3gp" Type="string" Value="" KeyPath="yes" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.3gp\OpenWithProgids" Name="Kiln.Convert" Type="string" Value="" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Applications\kiln-app.exe\SupportedTypes" Name=".aac" Type="string" Value="" />
