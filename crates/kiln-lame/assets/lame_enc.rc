// lame_enc.dll's version resource. The DLL is LAME 3.100, built and shipped
// with Kiln; LAME keeps its own copyright and the LGPL. build.rs passes the
// crate version as CARGO_PKG_VERSION_MAJOR, _MINOR and _PATCH.
#define KILN_STR2(x) #x
#define KILN_DOTTED2(a, b, c) KILN_STR2(a.b.c)
#define KILN_DOTTED(a, b, c) KILN_DOTTED2(a, b, c)
#define KILN_VERSION_STR KILN_DOTTED(CARGO_PKG_VERSION_MAJOR, CARGO_PKG_VERSION_MINOR, CARGO_PKG_VERSION_PATCH)

1 VERSIONINFO
FILEVERSION CARGO_PKG_VERSION_MAJOR, CARGO_PKG_VERSION_MINOR, CARGO_PKG_VERSION_PATCH, 0
PRODUCTVERSION CARGO_PKG_VERSION_MAJOR, CARGO_PKG_VERSION_MINOR, CARGO_PKG_VERSION_PATCH, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x2L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "LAME 3.100 MP3 encoder for Kiln"
            VALUE "CompanyName", "Chandler Crisp"
            VALUE "LegalCopyright", "LAME: Copyright (C) the LAME project. LGPL-2.0-or-later."
            VALUE "InternalName", "lame_enc"
            VALUE "FileVersion", KILN_VERSION_STR
            VALUE "OriginalFilename", "lame_enc.dll"
            VALUE "ProductName", "Kiln"
            VALUE "ProductVersion", KILN_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
