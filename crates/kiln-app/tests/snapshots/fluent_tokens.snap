[fluent.high-contrast]
base = window
layer = window | window
card = window | window
card_stroke = window_text
control = button_face
control_hover = button_face
control_pressed = button_face
control_stroke = window_text
control_hover_stroke = highlight
control_stroke_edge = top window_text
field_stroke = window_text
strong_stroke = window_text
divider = window_text
overlay = window
overlay_stroke = window_text
text = window_text
text_secondary = window_text
text_disabled = gray_text
control_text = button_text
accent = highlight
accent_hover = highlight
accent_edge = none
on_accent = highlight_text
accent_text = hotlight
selection = highlight
on_selection = highlight_text
critical = window_text
critical_fill = window
success = window_text
success_fill = window
caution = window_text
caution_fill = window
info = window_text
info_fill = window
smoke = none
focus_outer = window_text
focus_inner = window
close_hover = highlight
on_close_hover = highlight_text
kind_image = window_text
kind_video = window_text
kind_audio = window_text
kind_document = window_text
kind_other = window_text
flyout_shadow = none
dialog_shadow = none

[fluent.type]
caption = 12/16 400
body = 14/20 400
body_strong = 14/20 600
subtitle = 20/28 600
title = 28/36 600 tabular
code = 600 uppercase tracking 0.02
optical = Segoe UI Variable Small <= 12, Segoe UI Variable Text 13-19, Segoe UI Variable Display >= 20
ui_fallback = Segoe UI
icons = Segoe Fluent Icons, Segoe MDL2 Assets
icon_size = 16
icon_size_title_bar = 20
mono = Cascadia Mono, Consolas

[fluent.space]
grid = 4, 8, 12, 16, 24, 32, 48
window_edge = 16
window_edge_narrow = 0
narrow_below = 600
card_padding = 16
dialog_padding = 24
row_height = 56
thumb = 40
thumb_gap = 12
side_pane = 320-400
fold_below = 760
title_bar = 48
title_mark = 16 at 16
title_button = 40x32
caption_button = 46x48
button_height = 32
toggle = 40x20
progress_height = 3
selection_pill = 3x16
kind_dot = 6
kind_arc = 2
kind_badge_fill = 12%
focus = 2 outer, 1 inner, 2 gap
scroll_thumb = 2 rest, 6 hover
empty_mark = 64
wheel_gap = 2
stroke = 1
grid_unit = 4
panel_padding = 16
icon_grid = 24
icon_stroke = 1.5

[fluent.radius]
control = 4
layer = 8
progress = 1.5
wheel_inner = 4

[fluent.elevation]
0 base = mica
1 layer = fill
2 card = fill, card_stroke
3 overlay = overlay, overlay_stroke, shadow

[fluent.motion]
hover = 83 linear
small = 167 cubic-bezier(0, 0, 0, 1)
pane = 250 cubic-bezier(0, 0, 0, 1)
exit = 167 cubic-bezier(0.7, 0, 1, 0.5)
expander = 167 cubic-bezier(0, 0, 0, 1) turn 180
row_rise = 10
wheel_scale_from = 0.92
quick = 120

[fluent.glyphs]
settings = E713
help = E897
back = E72B
add_files = E710
show_in_folder = E838
more = E712
dismiss = E711
chevron_down = E70D
